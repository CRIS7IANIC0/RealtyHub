# Contract Service — copia este archivo a .env y ajusta los valores (nunca subas el .env real)
PORT=3006
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5436/realtyhub_contract_db?schema=public"
RABBITMQ_URL="amqp://localhost:5672"
# Dirección pública del frontend; el QR del PDF apunta a /verify/<id>
FRONTEND_URL=http://localhost:3002
# Clave del sello HMAC de las firmas (opcional; por defecto usa JWT_SECRET)
SIGNATURE_SECRET=
PROPERTY_SERVICE_URL=http://localhost:3003   # en Railway: http://${{property-service.RAILWAY_PRIVATE_DOMAIN}}:3003
LEAD_SERVICE_URL=http://localhost:3004   # en Railway: http://${{lead-service.RAILWAY_PRIVATE_DOMAIN}}:3004
USER_SERVICE_URL=http://localhost:3001   # en Railway: http://${{user-service.RAILWAY_PRIVATE_DOMAIN}}:3001
