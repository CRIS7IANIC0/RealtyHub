generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id          String   @id @default(uuid())
  title       String
  description String
  address     String
  price       Float
  status      String   @default("Disponible")
  images      String[] @default([])

  @@map("properties")
}