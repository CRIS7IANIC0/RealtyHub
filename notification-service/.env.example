# Notification Service — copia este archivo a .env y ajusta los valores (nunca subas el .env real)
PORT=3009
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5439/realtyhub_notification_db?schema=public"
RABBITMQ_URL="amqp://localhost:5672"
# Servidor SMTP (opcional; sin él no se envían correos)
SMTP_HOST=
# Puerto SMTP (587 por defecto)
SMTP_PORT=587
# "true" para TLS directo
SMTP_SECURE=false
# Usuario SMTP
SMTP_USER=
# Contraseña SMTP
SMTP_PASS=
# Remitente, p. ej. RealtyHub <no-reply@dominio.com>
SMTP_FROM=RealtyHub <no-reply@realtyhub.com>
USER_SERVICE_URL=http://localhost:3001   # en Railway: http://${{user-service.RAILWAY_PRIVATE_DOMAIN}}:3001
LEAD_SERVICE_URL=http://localhost:3004   # en Railway: http://${{lead-service.RAILWAY_PRIVATE_DOMAIN}}:3004
PROPERTY_SERVICE_URL=http://localhost:3003   # en Railway: http://${{property-service.RAILWAY_PRIVATE_DOMAIN}}:3003
VIEWING_SERVICE_URL=http://localhost:3005   # en Railway: http://${{viewing-service.RAILWAY_PRIVATE_DOMAIN}}:3005
