VIEWING_SERVICE_URL=http://localhost:3005
CONTRACT_SERVICE_URL=http://localhost:3006
COMMISSION_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3009
