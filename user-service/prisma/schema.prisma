generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Office {
  id     String @id @default(uuid())
  name   String
  region String
  users  User[] 
  
  @@map("offices") 
}

model User {
  id        String @id @default(uuid())
  office_id String
  name      String
  email     String
  password  String   @default("123456")
  role      String   @default("AGENTE")
  
  office    Office @relation(fields: [office_id], references: [id])
  
  @@map("users") // Cambiamos la tabla a "users"
}